\contentsline {figure}{\numberline {C.1}{\ignorespaces Arquitectura de la interfaz web. Los CSV/JSON del pipeline se leen desde \texttt {paso12\_datos.py} (datos) y \texttt {contexto\_tfm.py} (prompt del asistente). El router de \texttt {paso12\_web\_chatbot.py} expone dos vistas: la portada (\texttt {/}) y el dashboard del framework (\texttt {/framework}). La línea discontinua indica la dependencia externa opcional (API de Groq) del asistente conversacional.}}{54}{figure.caption.30}%
\contentsline {figure}{\numberline {C.2}{\ignorespaces Portada de la interfaz \texttt {data.lung}. Fondo con terminal animada reproduciendo trazas reales del pipeline, tipografía mono con acento verde y CTA \emph {Comenzar}.}}{55}{figure.caption.31}%
\contentsline {figure}{\numberline {C.3}{\ignorespaces Capítulo \emph {Inicio} del framework. Título, entradilla y hero de cinco cifras con acento verde.}}{56}{figure.caption.32}%
\contentsline {figure}{\numberline {C.4}{\ignorespaces Capítulo \emph {Asistente}. Cabecera con avatar y estado en línea, sugerencias iniciales de conversación y input anclado abajo.}}{57}{figure.caption.33}%
\contentsline {figure}{\numberline {C.5}{\ignorespaces Capítulo \emph {Introducción y objetivos}. Se aprecia la tabla de cohortes con la barra de progreso de curación LLM y el caption dinámico.}}{58}{figure.caption.34}%
\contentsline {figure}{\numberline {C.6}{\ignorespaces Capítulo \emph {Metodología}. Bloques numerados con las fases del pipeline y comandos de reproducibilidad.}}{59}{figure.caption.35}%
\contentsline {figure}{\numberline {C.7}{\ignorespaces Capítulo \emph {Resultados}. Se aprecia la cabecera de cuatro tarjetas, el buscador de gen y el inicio de la sección de subtipo.}}{60}{figure.caption.36}%
\contentsline {figure}{\numberline {C.8}{\ignorespaces Capítulo \emph {Cohortes}. Selector de cohorte y bloque de cifras por dataset.}}{61}{figure.caption.37}%
\contentsline {figure}{\numberline {C.9}{\ignorespaces Capítulo \emph {Conclusiones}. Lista de biomarcadores por linaje con cifras de recuperación IHC.}}{62}{figure.caption.38}%
